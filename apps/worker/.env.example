NODE_ENV=development

MONGODB_URI=mongodb://localhost:27018/youtube-platform
REDIS_URL=redis://localhost:6379

# Local filesystem storage - must be the same absolute path apps/api uses.
STORAGE_ROOT=/absolute/path/to/storage-data

# If yt-dlp isn't on this process's PATH (e.g. a pip --user install whose
# Scripts dir isn't inherited by every shell/process manager), use its full path.
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Optional - only needed once YouTube starts responding with "Sign in to
# confirm you're not a bot" for your IP/client. Set at most one:
# YTDLP_COOKIES_FROM_BROWSER=chrome
# YTDLP_COOKIES_FILE=/absolute/path/to/cookies.txt

# Optional - a directory to prepend to yt-dlp's PATH, e.g. a JS runtime (Deno
# is recommended) yt-dlp needs to solve YouTube's "n" challenge. Only needed if
# that runtime isn't already resolvable from this process's own PATH.
# YTDLP_EXTRA_PATH=/absolute/path/to/deno/directory
