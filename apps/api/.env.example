NODE_ENV=development
PORT=4000

MONGODB_URI=mongodb://localhost:27018/youtube-platform
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Local filesystem storage - must be the same absolute path apps/worker uses.
STORAGE_ROOT=/absolute/path/to/storage-data
STORAGE_SIGNING_SECRET=change-me-too
API_PUBLIC_URL=http://localhost:4000

WEB_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3001
